# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real secrets.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Keep True only for local development.
DEBUG=True

# Comma-separated list of hostnames this app is allowed to serve.
ALLOWED_HOSTS=127.0.0.1,localhost

# Used to encrypt SMTP passwords before they're stored in the database.
# Generate with: python manage.py generate_fernet_key
# If you change this after saving SMTP servers, their stored passwords
# become unreadable and will need to be re-entered.
FERNET_KEY=change-me

# Seconds to wait between individual sends.
SEND_DELAY_SECONDS=1.5

# --- PostgreSQL ---
# Point these at a database you've already created (see README).
PGDATABASE=mailer
PGUSER=postgres
PGPASSWORD=change-me
PGHOST=localhost
PGPORT=5432
